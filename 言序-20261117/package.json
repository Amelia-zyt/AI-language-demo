{
  "name": "lingua-workspace",
  "private": true,
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev:worker": "npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy",
    "d1:init:local": "npx wrangler d1 execute lingua-db --local --file=db/schema.sql",
    "d1:init:remote": "npx wrangler d1 execute lingua-db --remote --file=db/schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "wrangler": "^4.158.0"
  }
}
